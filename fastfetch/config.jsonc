{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "//home/shubham/.config/fastfetch/7rm.png",
        "height": 14,
        "padding": {
            "top": 2,
            "left": 2,
            "right": 4,
            "bottom": 2
        }
    },

    "display": {
        "separator": " "
    },

    "modules": [
        "break",
        "break",
        "break",

        {
            "type": "os",
            "key": " OS: ",
            "keyColor": "33"
        },

        "break",

        {
            "type": "kernel",
            "key": "  KERNEL: ",
            "keyColor": "33"
        },

        "break",

        {
            "type": "shell",
            "key": "  SHELL: ",
            "keyColor": "33"
        },

        "break",

        {
            "type": "terminal",
            "key": "  TERMINAL: ",
            "keyColor": "33"
        },

        "break",

        {
            "type": "wm",
            "key": "  WINDOW MANAGER: ",
            "keyColor": "33"
        },

        "break",

        {
            "type": "uptime",
            "key": " UPTIME: ",
            "keyColor": "33"
        },

        "break",

        {
            "type": "command",
            "key": "󰝚  ",
            "keyColor": "33",
            "shell": "/bin/sh",
            "text": "player=$(playerctl metadata --format '{{playerName}}' 2>/dev/null); title=$(playerctl metadata --format '{{title}}' 2>/dev/null); case \"$player\" in *spotify*) service='Spotify' ;; *firefox*|*chrom*) service='YouTube' ;; *) service=\"$player\" ;; esac; [ -n \"$title\" ] && printf '%s • %s' \"$title\" \"$service\""
        },

        "break",

        // {
        //     "type": "command",
        //     "key": " ",
        //     "shell": "/bin/fish",
        //     "text": "echo '名誉を失う前に死ぬ'",
        //     "format": "{1}"
        // },

        "break",
        "break",
        "break"
    ]
}
